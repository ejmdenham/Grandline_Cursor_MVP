# Copy this file to terraform.tfvars to override defaults (optional).
# Do not commit terraform.tfvars (add to .gitignore if needed).
#
# Admin Terraform reads cognito_user_pool_id, cognito_user_pool_arn, races_table_name, races_table_arn
# from player Terraform state (infra/terraform/terraform.tfstate). Apply player Terraform first.

region             = "eu-north-1"
project_name       = "grandline"
stage              = "dev"
admin_callback_url = "http://localhost:5173/callback"
# enable_admin_hosting = true  # Phase 3.5: set true to deploy admin app to S3/CloudFront
