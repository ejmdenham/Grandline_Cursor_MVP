# Mobile app (Phase 2) — copy to .env and fill from Terraform outputs.
# Run: cd infra/terraform && terraform output
# Do not commit .env (it is in .gitignore).

# API base URL (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=

# Cognito — from terraform output cognito_user_pool_id, cognito_app_client_id
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_REGION=eu-north-1

# Optional: Hosted UI base URL for sign-in/sign-up in browser
# Format: https://<cognito_hosted_ui_domain>.auth.eu-north-1.amazoncognito.com
# EXPO_PUBLIC_COGNITO_HOSTED_UI_URL=
