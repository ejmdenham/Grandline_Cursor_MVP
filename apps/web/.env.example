# Admin API base URL (from admin Terraform output: admin_api_url)
VITE_ADMIN_API_URL=
# Cognito (from player Terraform: cognito_user_pool_id, cognito_hosted_ui_domain; from admin Terraform: admin_cognito_client_id)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=eu-north-1
# Hosted UI domain prefix (player output cognito_hosted_ui_domain), e.g. grandline-player-auth
VITE_COGNITO_HOSTED_UI_PREFIX=
