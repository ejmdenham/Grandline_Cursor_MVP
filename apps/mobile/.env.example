# Reference: EXPO_PUBLIC_* keys used by the app. This file is not loaded by Expo.
# The actual file is apps/mobile/.env, auto-generated by terraform apply (mobile_env.tf) or scripts/gen-env.sh.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_REGION=eu-north-1
